        "question_3wn6Te": {
          "type": "question",
          "settings": {
            "question": "What is WishLuck?",
            "answer": "<p>An Indian educational toy brand for kids aged 0–7. We offer 100+ screen-free, research-backed learning toys — sound books, balance bikes, puzzles, musical toys, art kits, and more. Trusted by 3 lakh+ parents with a 4.8/5 rating.</p>",
            "open_by_default": false
          }
        },
        "question_dF437B": {
          "type": "question",
          "settings": {
            "question": "Are the toys safe for babies and toddlers?",
            "answer": "<p>Yes. Every toy is made from child-safe, non-toxic, BPA-free materials with no small detachable parts, and is tested for safe edges and finishes.</p>",
            "open_by_default": false
          }
        },
        "question_ThfEF7": {
          "type": "question",
          "settings": {
            "question": "Which age group are the toys for?",
            "answer": "<p>Kids aged 0–7 years — sensory toys (0–1), early learning (1–3), pre-school readiness (3–5), and skill-building games (5–7). Each product page shows the recommended age.</p>",
            "open_by_default": false
          }
        },
        "question_g8KL99": {
          "type": "question",
          "settings": {
            "question": "How do the toys help my child's development?",
            "answer": "<p>Built on multi-sensory, screen-free learning principles, they develop motor skills, early literacy and numeracy, hand-eye coordination, problem-solving, and creativity — through hands-on play, not screens.</p>",
            "open_by_default": false
          }
        },
        "question_aMKBLz": {
          "type": "question",
          "settings": {
            "question": "Why choose WishLuck over other brands?",
            "answer": "<p>Designed for Indian children — bilingual options, culturally relevant themes, and honest pricing. Backed by 3 lakh+ customers, 93%+ parent satisfaction, and 25,000+ verified reviews at 4.8/5.</p>",
            "open_by_default": false
          }
        }
      },
