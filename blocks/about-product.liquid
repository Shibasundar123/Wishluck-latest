{%- liquid
  assign block_settings = block.settings
-%}

<div
  class="wl-about-product quick-add-hidden spacing-style"
  style="{% render 'spacing-padding', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.heading != blank -%}
    <h2 class="wl-about-product__heading">{{ block_settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="wl-about-product__list">
    {%- for i in (1..4) -%}
      {%- liquid
        case i
          when 1
            assign item_title = block_settings.item1_title
            assign item_content = block_settings.item1_content
          when 2
            assign item_title = block_settings.item2_title
            assign item_content = block_settings.item2_content
          when 3
            assign item_title = block_settings.item3_title
            assign item_content = block_settings.item3_content
          when 4
            assign item_title = block_settings.item4_title
            assign item_content = block_settings.item4_content
        endcase
      -%}
      {%- if item_title != blank and item_content != blank -%}
        <details class="wl-about-product__item"{% if i == 1 %} open{% endif %} name="AboutProduct-{{ block.id }}-{{ section.id }}">
          <summary class="wl-about-product__summary">
            <span class="wl-about-product__title">{{ item_title | escape }}</span>
            <span class="wl-about-product__toggle" aria-hidden="true"></span>
          </summary>
          <div class="wl-about-product__content rte">
            {{ item_content }}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .wl-about-product {
    width: 100%;
  }

  .wl-about-product__heading {
    margin: 0 0 var(--margin-lg, 16px);
  }

  .wl-about-product__list {
    display: flex;
    flex-direction: column;
  }

  .wl-about-product__item {
    border-top: 1px solid var(--color-border, #e6e6e6);
  }

  .wl-about-product__item:last-child {
    border-bottom: 1px solid var(--color-border, #e6e6e6);
  }

  .wl-about-product__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .wl-about-product__summary::-webkit-details-marker {
    display: none;
  }

  .wl-about-product__title {
    font-weight: 600;
  }

  .wl-about-product__toggle {
    flex-shrink: 0;
    position: relative;
    width: 12px;
    height: 12px;
  }

  .wl-about-product__toggle::before,
  .wl-about-product__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .wl-about-product__toggle::before {
    width: 12px;
    height: 2px;
  }

  .wl-about-product__toggle::after {
    width: 2px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .wl-about-product__item[open] .wl-about-product__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .wl-about-product__content {
    padding: 0 0 16px;
  }
{% endstylesheet %}

