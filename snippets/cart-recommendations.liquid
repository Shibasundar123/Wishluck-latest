{% doc %}
  Recommended products row for the cart drawer. Fully driven by global theme settings
  (Theme settings → Cart → Recommended products), so it can be reused anywhere the cart is rendered.

  Each card is a plain product form that reuses the theme's `product-form-component`, so adding a
  product goes through the same /cart/add + section-morph path as every other add-to-cart button —
  no extra JS. "Add" always adds the first available variant; sold-out products are skipped.

  Because the drawer section is re-rendered on every cart change, products already in the cart
  drop out of the row on their own when "Hide products already in the cart" is on.

  @example
  {% render 'cart-recommendations' %}
{% enddoc %}

{%- liquid
  assign products = settings.cart_recs_products

  if settings.cart_recs_hide_in_cart
    # Build a '|123|456|' lookup once instead of scanning cart.items per product
    assign in_cart_ids = cart.items | map: 'product_id' | join: '|' | prepend: '|' | append: '|'
  endif

  assign render_recs = false
  if settings.cart_recs_enabled and products.size > 0
    assign render_recs = true
  endif
-%}

{%- if render_recs -%}
  {%- capture cards -%}
    {%- for product in products -%}
      {%- liquid
        if settings.cart_recs_hide_in_cart
          assign lookup = product.id | prepend: '|' | append: '|'
          if in_cart_ids contains lookup
            continue
          endif
        endif

        # Sold out (no purchasable variant) or subscription-only: nothing "Add" could add
        if product.available == false or product.requires_selling_plan
          continue
        endif

        assign variant = product.first_available_variant
        assign form_id = 'CartRecs-ProductForm-' | append: product.id
      -%}
      <li class="cart-recs__item">
        <a
          href="{{ product.url }}"
          class="cart-recs__media"
          tabindex="-1"
          aria-hidden="true"
        >
          {%- if product.featured_image -%}
            {{-
              product.featured_image
              | image_url: width: 240
              | image_tag:
                widths: '120, 240',
                sizes: '120px',
                loading: 'lazy',
                alt: ''
            -}}
          {%- else -%}
            {{- 'product-1' | placeholder_svg_tag: 'cart-recs__placeholder' -}}
          {%- endif -%}
        </a>

        <div class="cart-recs__body">
          <a
            href="{{ product.url }}"
            class="cart-recs__title cart-primary-typography"
          >
            {{- product.title | escape -}}
          </a>

          <p class="cart-recs__price cart-secondary-typography">
            <span>{{ variant.price | money_without_trailing_zeros }}</span>
            {%- if variant.compare_at_price > variant.price -%}
              <s>{{ variant.compare_at_price | money_without_trailing_zeros }}</s>
            {%- endif -%}
          </p>
        </div>

        <product-form-component
          data-section-id="cart-drawer-section"
          data-product-id="{{ product.id }}"
          on:submit="/handleSubmit"
          class="cart-recs__form"
        >
          <div
            class="visually-hidden"
            aria-live="polite"
            role="status"
            ref="liveRegion"
          ></div>
          {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              ref="variantId"
              value="{{ variant.id }}"
            >
            <input
              type="hidden"
              name="quantity"
              value="{{ variant.quantity_rule.min | default: 1 }}"
            >
            {%- comment -%}
              Inline add-to-cart-component (instead of the shared snippet) so the fly-to-cart
              animation stays off — the header cart icon sits behind the open drawer.
            {%- endcomment -%}
            <add-to-cart-component
              ref="addToCartButtonContainer"
              data-add-to-cart-animation="false"
            >
              <button
                type="submit"
                name="add"
                ref="addToCartButton"
                on:click="/handleClick"
                class="button cart-recs__add add-to-cart-button"
                aria-label="{{ 'actions.add' | t }} – {{ product.title | escape }}"
              >
                <span class="add-to-cart-text">
                  <span class="svg-wrapper cart-recs__add-icon">
                    {{- 'icon-plus.svg' | inline_asset_content -}}
                  </span>
                  {{- 'actions.add' | t -}}
                </span>
                <span class="add-to-cart__added">
                  <span class="svg-wrapper add-to-cart__added-icon">
                    {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                  </span>
                </span>
              </button>
            </add-to-cart-component>
          {%- endform -%}
        </product-form-component>
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  {%- comment -%} Every product may already be in the cart — render nothing rather than an empty row {%- endcomment -%}
  {%- if cards contains 'cart-recs__item' -%}
    <section
      class="cart-recs"
      aria-labelledby="cart-recs-heading"
      data-cart-recommendations
    >
      {%- if settings.cart_recs_heading != blank -%}
        <h3
          id="cart-recs-heading"
          class="cart-recs__heading cart-primary-typography"
        >
          {{- settings.cart_recs_heading | escape -}}
        </h3>
      {%- endif -%}

      <ul class="cart-recs__list list-unstyled">
        {{ cards }}
      </ul>
    </section>
  {%- endif -%}
{%- endif -%}

{% render 'cart-typography-styles' %}
{% render 'add-to-cart-button-styles' %}

{% stylesheet %}
  .cart-recs {
    --cart-recs-card-width: 132px;
    --cart-recs-radius: 1rem;

    flex-shrink: 0;
    width: 100%;
    padding-block: var(--padding-md) var(--padding-sm);
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-block-start: var(--margin-md);
  }

  .cart-recs__heading {
    margin: 0 var(--cart-drawer-padding, var(--padding-xl)) var(--margin-sm);
    font-size: var(--font-size--sm);
    font-weight: var(--font-weight-bold, 700);
    line-height: 1.3;
  }

  /* Horizontal snap row; the drawer's inline padding becomes scroll padding so
     the first/last card line up with the line items above */
  .cart-recs__list {
    display: flex;
    gap: var(--gap-sm);
    margin: 0;
    padding-block: 2px;
    padding-inline: var(--cart-drawer-padding, var(--padding-xl));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--cart-drawer-padding, var(--padding-xl));
    scrollbar-width: none;
  }

  .cart-recs__list::-webkit-scrollbar {
    display: none;
  }

  /* Hard-locked width: flex-basis alone lets a card grow to its min-content
     (long price, nowrap text), so width/min/max are all pinned */
  .cart-recs__item {
    display: flex;
    flex: 0 0 var(--cart-recs-card-width);
    flex-direction: column;
    gap: 6px;
    width: var(--cart-recs-card-width);
    min-width: 0;
    max-width: var(--cart-recs-card-width);
    scroll-snap-align: start;
    padding: 6px 6px 8px;
    border-radius: var(--cart-recs-radius);
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .cart-recs__media {
    display: block;
    aspect-ratio: 1;
    border-radius: calc(var(--cart-recs-radius) - 6px);
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  /* Square on the image itself (not via a % height) so the width/height attributes
     from image_tag and base.css's img { height: auto } can't stretch it */
  .cart-recs .cart-recs__media img,
  .cart-recs .cart-recs__placeholder {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .cart-recs__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cart-recs__title {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--color-foreground);
    font-size: var(--font-size--xs);
    line-height: 1.3;
    text-decoration: none;
  }

  .cart-recs__title:hover {
    text-decoration: underline;
  }

  .cart-recs__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gap-2xs);
    margin: 0;
    font-size: var(--font-size--xs);
    font-weight: var(--font-weight-bold, 700);
    line-height: 1.2;
  }

  .cart-recs__price s {
    font-weight: var(--font-weight-normal, 400);
    opacity: 0.6;
  }

  .cart-recs__media,
  .cart-recs__form,
  .cart-recs__form form,
  .cart-recs__form add-to-cart-component {
    display: block;
    width: 100%;
    min-width: 0;
  }

  /* Compact pill button. Padding/height are set directly (not via the .button vars) so the
     28px height holds regardless of where the shared button styles land in the bundle */
  .cart-recs .cart-recs__add {
    --button-color: var(--color-foreground);
    --button-background-color: var(--color-background);
    --button-border-width: 1px;
    --button-border-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    --icon-stroke-width: 1.5px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 100%;
    height: 28px;
    min-height: 0;
    padding: 0 var(--padding-xs);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold, 700);
    line-height: 1;
  }

  .cart-recs .cart-recs__add:hover {
    --button-border-color: var(--color-foreground);
  }

  .cart-recs .cart-recs__add .add-to-cart-text {
    gap: 4px;
  }

  /* Beat .svg-wrapper / .svg-wrapper > svg from base.css */
  .cart-recs .cart-recs__add .cart-recs__add-icon,
  .cart-recs .cart-recs__add .cart-recs__add-icon > svg {
    width: 11px;
    height: 11px;
  }

  /* Checkmark burst scaled to the shorter button */
  .cart-recs .cart-recs__add .add-to-cart__added-icon,
  .cart-recs .cart-recs__add .add-to-cart__added-icon .checkmark-burst {
    width: 22px;
    height: 22px;
  }

  @media screen and (max-width: 749px) {
    .cart-recs {
      --cart-recs-card-width: 124px;
    }
  }
{% endstylesheet %}
