{% doc %}
  Renders the cart rewards progress bar. Fully driven by global theme settings
  (Theme settings → Cart → Rewards progress bar), so it can be reused anywhere the cart is rendered.

  Up to 3 reward tiers are supported. Milestones are spaced evenly along the bar and the fill
  is interpolated between the previous and next milestone based on the current cart value.

  @example
  {% render 'cart-progress-bar' %}
{% enddoc %}

{%- liquid
  assign progress_type = settings.cart_progress_type | default: 'item_count'

  if progress_type == 'cart_total'
    assign current_value = cart.total_price
  else
    assign current_value = cart.item_count
  endif

  # Collect tiers that have both a label and a threshold > 0
  assign tier_labels = ''
  assign tier_thresholds = ''
  assign tier_count = 0

  for i in (1..3)
    assign label_key = 'cart_progress_tier' | append: i | append: '_label'
    assign threshold_key = 'cart_progress_tier' | append: i | append: '_threshold'
    assign tier_label = settings[label_key]
    assign tier_threshold = settings[threshold_key] | default: 0 | plus: 0

    if tier_label != blank and tier_threshold > 0
      if progress_type == 'cart_total'
        assign tier_threshold = tier_threshold | times: 100
      endif
      assign tier_count = tier_count | plus: 1
      assign tier_labels = tier_labels | append: tier_label | append: '§§'
      assign tier_thresholds = tier_thresholds | append: tier_threshold | append: '§§'
    endif
  endfor

  assign labels = tier_labels | split: '§§'
  assign thresholds = tier_thresholds | split: '§§'

  assign render_bar = false
  if settings.cart_progress_enabled and tier_count > 0
    assign render_bar = true
  endif

  # Milestones sit at i / (n + 0.5) so the bar extends a little past the last one
  assign slots = tier_count | plus: 0.5

  assign fill = 0.0
  assign unlocked_count = 0
  assign next_index = -1
  assign prev_threshold = 0
  assign prev_pos = 0.0

  for threshold_string in thresholds
    assign threshold = threshold_string | plus: 0
    assign pos = forloop.index | times: 100.0 | divided_by: slots

    if current_value >= threshold
      assign fill = pos
      assign unlocked_count = forloop.index
    elsif next_index == -1
      assign next_index = forloop.index0
      assign range = threshold | minus: prev_threshold
      assign progressed = current_value | minus: prev_threshold
      if range > 0
        assign ratio = progressed | times: 1.0 | divided_by: range
      else
        assign ratio = 1.0
      endif
      assign fill = pos | minus: prev_pos | times: ratio | plus: prev_pos
    endif

    assign prev_threshold = threshold
    assign prev_pos = pos
  endfor

  assign all_unlocked = false
  if next_index == -1
    assign all_unlocked = true
    assign fill = 100.0
    assign heading = settings.cart_progress_heading_unlocked
  else
    assign next_threshold = thresholds[next_index] | plus: 0
    assign remaining = next_threshold | minus: current_value

    if progress_type == 'cart_total'
      assign remaining_text = remaining | money_without_trailing_zeros
    elsif remaining == 1
      assign remaining_text = remaining | append: ' item'
    else
      assign remaining_text = remaining | append: ' items'
    endif

    assign heading = settings.cart_progress_heading_locked | replace: '[remaining]', remaining_text | replace: '[reward]', labels[next_index]
  endif

  assign fill_rounded = fill | round: 1
-%}

{%- if render_bar -%}
<div
  class="cart-progress{% if all_unlocked %} cart-progress--complete{% endif %}"
  data-cart-progress
  style="
    --cart-progress-fill: {{ fill_rounded }}%;
    --cart-progress-banner-bg: {{ settings.cart_progress_banner_bg }};
    --cart-progress-banner-text: {{ settings.cart_progress_banner_text }};
    --cart-progress-bar: {{ settings.cart_progress_bar_color }};
    --cart-progress-track: {{ settings.cart_progress_track_color }};
    --cart-progress-node: {{ settings.cart_progress_node_color }};
    --cart-progress-reward-bg: {{ settings.cart_progress_reward_bg }};
    --cart-progress-reward-text: {{ settings.cart_progress_reward_text }};
    --cart-progress-threshold-bg: {{ settings.cart_progress_threshold_bg }};
    --cart-progress-threshold-text: {{ settings.cart_progress_threshold_text }};
  "
>
  {%- if heading != blank -%}
    <p
      class="cart-progress__banner"
      role="status"
      aria-live="polite"
    >
      {{ heading }}
    </p>
  {%- endif -%}

  <div class="cart-progress__milestones">
    <div
      class="cart-progress__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ fill | round }}"
      aria-label="{{ heading | strip_html | escape }}"
    >
      <div class="cart-progress__fill"></div>
    </div>

    {%- for label in labels -%}
      {%- liquid
        assign threshold = thresholds[forloop.index0] | plus: 0
        assign pos = forloop.index | times: 100.0 | divided_by: slots | round: 2
        assign is_unlocked = false
        if forloop.index <= unlocked_count
          assign is_unlocked = true
        endif

        if progress_type == 'cart_total'
          assign threshold_text = threshold | money_without_trailing_zeros
        elsif threshold == 1
          assign threshold_text = threshold | append: ' item'
        else
          assign threshold_text = threshold | append: ' items'
        endif
      -%}
      <div
        class="cart-progress__tier{% if is_unlocked %} cart-progress__tier--unlocked{% endif %}"
        style="--cart-progress-tier-position: {{ pos }}%;"
      >
        <span class="cart-progress__pill cart-progress__pill--reward">{{ label }}</span>
        <span class="cart-progress__node" aria-hidden="true">
          {%- if is_unlocked -%}
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
          {%- endif -%}
        </span>
        <span class="cart-progress__pill cart-progress__pill--threshold">
          {{ threshold_text }}
          <span class="visually-hidden">
            {%- if is_unlocked %} – unlocked{% else %} – locked{% endif -%}
          </span>
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .cart-progress {
    --cart-progress-pill-height: 18px;
    --cart-progress-pill-gap: 5px;
    --cart-progress-node-size: 24px;
    --cart-progress-bar-height: 8px;

    flex-shrink: 0;
    width: 100%;
    font-family: var(--font-body--family);
    line-height: 1.2;
    background-color: var(--color-background);
    border-block-end: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-block-end: var(--margin-sm);
  }

  .cart-progress__banner {
    margin: 0;
    padding: 4px var(--cart-drawer-padding, var(--padding-xl));
    background-color: var(--cart-progress-banner-bg);
    color: var(--cart-progress-banner-text);
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 0.8125rem;
    text-align: center;
    text-wrap: balance;
  }

  .cart-progress__milestones {
    position: relative;
    height: calc(var(--cart-progress-pill-height) * 2 + var(--cart-progress-pill-gap) * 2 + var(--cart-progress-node-size));
    margin-inline: var(--cart-drawer-padding, var(--padding-xl));
    margin-block: var(--margin-xs) var(--margin-sm);
  }

  .cart-progress__track {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--cart-progress-pill-height) + var(--cart-progress-pill-gap) + var(--cart-progress-node-size) / 2);
    height: var(--cart-progress-bar-height);
    transform: translateY(-50%);
    border-radius: 999px;
    background-color: var(--cart-progress-track);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.08);
    overflow: hidden;
  }

  .cart-progress__fill {
    width: var(--cart-progress-fill, 0%);
    height: 100%;
    border-radius: inherit;
    background-color: var(--cart-progress-bar);
    transition: width var(--animation-speed-medium, 0.4s) var(--animation-easing, ease);
  }

  .cart-progress__tier {
    position: absolute;
    top: 0;
    left: var(--cart-progress-tier-position);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cart-progress-pill-gap);
  }

  .cart-progress__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--cart-progress-pill-height);
    padding-inline: 7px;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: opacity var(--animation-speed-medium, 0.4s) var(--animation-easing, ease);
  }

  /* Small caret linking the pill to its milestone */
  .cart-progress__pill::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 6px;
    height: 6px;
    background-color: inherit;
    transform: translateX(-50%) rotate(45deg);
  }

  .cart-progress__pill--reward {
    background-color: var(--cart-progress-reward-bg);
    color: var(--cart-progress-reward-text);
    text-transform: uppercase;
  }

  .cart-progress__pill--reward::after {
    bottom: -2px;
  }

  .cart-progress__pill--threshold {
    background-color: var(--cart-progress-threshold-bg);
    color: var(--cart-progress-threshold-text);
    font-weight: 600;
  }

  .cart-progress__pill--threshold::after {
    top: -2px;
  }

  .cart-progress__node {
    --icon-stroke-width: 2px;

    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--cart-progress-node-size);
    height: var(--cart-progress-node-size);
    border-radius: 50%;
    background-color: #fff;
    color: #fff;
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.15);
    transition:
      background-color var(--animation-speed-medium, 0.4s) var(--animation-easing, ease),
      transform var(--animation-speed-medium, 0.4s) var(--animation-easing, ease);
  }

  /* Locked: hollow ring on the track colour */
  .cart-progress__node::before {
    content: '';
    width: 40%;
    height: 40%;
    border-radius: 50%;
    background-color: var(--cart-progress-track);
  }

  .cart-progress__tier--unlocked .cart-progress__node {
    background-color: var(--cart-progress-node);
  }

  .cart-progress__tier--unlocked .cart-progress__node::before {
    display: none;
  }

  .cart-progress__node svg {
    width: 60%;
    height: 60%;
  }

  .cart-progress__tier:not(.cart-progress__tier--unlocked) .cart-progress__pill {
    opacity: 0.7;
  }

  .cart-progress--complete .cart-progress__tier:last-child .cart-progress__node {
    animation: cart-progress-pop var(--animation-speed-medium, 0.4s) var(--animation-easing, ease);
  }

  @keyframes cart-progress-pop {
    50% {
      transform: scale(1.15);
    }
  }

  @media screen and (max-width: 749px) {
    .cart-progress {
      --cart-progress-pill-height: 17px;
      --cart-progress-node-size: 22px;
    }

    .cart-progress__pill {
      padding-inline: 6px;
      font-size: 0.5625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-progress__fill,
    .cart-progress__node,
    .cart-progress__pill {
      transition: none;
    }

    .cart-progress--complete .cart-progress__tier:last-child .cart-progress__node {
      animation: none;
    }
  }
{% endstylesheet %}
