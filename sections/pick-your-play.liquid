{%- comment -%}
  Pick Your Play — a split of 2–3 large category cards (e.g. Toys vs Books).
  Each card: pastel background, wide image on top, title + short text below,
  optional "Shop now →" call-to-action. The whole card is a link when a URL is set.

  Performance notes:
  - Zero JavaScript. Layout, hover and the mobile carousel are pure CSS.
  - Styles live in {% stylesheet %} so Shopify bundles them into the theme's single CSS file.
  - Images use responsive srcset/sizes, native lazy-loading, async decoding and an explicit
    CSS aspect-ratio box, so nothing shifts while loading.
  - Missing images fall back to a CSS striped placeholder — no placeholder image request.
  - Text contrast is resolved in Liquid at render time; nothing is computed in the browser.
{%- endcomment -%}

{% liquid
  assign columns = section.settings.columns | plus: 0
  assign mobile_layout = section.settings.mobile_layout

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '16 / 9'
  endcase

  # sizes attribute: desktop share of viewport per column, tablet 2-up (or 1-up), mobile per layout
  assign desktop_vw = 100 | divided_by: columns
  if mobile_layout == 'scroll'
    assign mobile_vw = 85
  else
    assign mobile_vw = 100
  endif
  assign sizes = '(min-width: 990px) ' | append: desktop_vw | append: 'vw, (min-width: 750px) 50vw, ' | append: mobile_vw | append: 'vw'

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="pick-your-play-{{ section.id }}"
>
  <div
    class="pick-play pick-play--mobile-{{ mobile_layout }}"
    style="
      --pp-columns: {{ columns }};
      --pp-gap: {{ section.settings.gap }}px;
      --pp-radius: {{ section.settings.corner_radius }}px;
      --pp-ratio: {{ ratio }};
    "
  >
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="pick-play__header pick-play__header--{{ section.settings.heading_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="pick-play__heading h2">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="pick-play__subheading paragraph">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <ul class="pick-play__grid list-unstyled" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign bs = block.settings
          assign card_bg = bs.card_color

          # Resolve a readable text colour once, server-side (mirrors contrast-override logic).
          if bs.text_color != blank
            assign card_fg = bs.text_color
          elsif card_bg != blank
            assign contrast = card_bg | color_contrast: settings.page_text_color
            assign brightness = card_bg | color_brightness
            if contrast >= 4.5
              assign card_fg = settings.page_text_color
            elsif brightness > 128
              assign card_fg = 'var(--palette-darkest)'
            else
              assign card_fg = 'var(--palette-lightest)'
            endif
          else
            assign card_fg = 'var(--color-foreground)'
          endif

          if bs.link != blank
            assign tag = 'a'
          else
            assign tag = 'div'
          endif

          # Only the first row is eligible for eager loading, and only when the merchant opts in.
          assign loading = 'lazy'
          if section.settings.eager_first_row and forloop.index <= columns
            assign loading = 'eager'
          endif
        %}
        <li class="pick-play__item" {{ block.shopify_attributes }}>
          <{{ tag }}
            class="pick-play__card"
            {% if tag == 'a' %}
              href="{{ bs.link }}"
            {% endif %}
            style="{% if card_bg != blank %}--card-bg: {{ card_bg }};{% endif %} --card-fg: {{ card_fg }};"
          >
            {% if bs.image != blank %}
              <div class="pick-play__media">
                {{
                  bs.image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '400, 500, 600, 800, 1000, 1200, 1400, 1600',
                    sizes: sizes,
                    loading: loading,
                    decoding: 'async',
                    class: 'pick-play__img'
                }}
              </div>
            {% else %}
              <div class="pick-play__media pick-play__media--placeholder" aria-hidden="true"></div>
            {% endif %}

            <div class="pick-play__body">
              <div class="pick-play__copy">
                {% if bs.title != blank %}
                  <h3 class="pick-play__title h3">{{ bs.title | escape }}</h3>
                {% endif %}
                {% if bs.description != blank %}
                  <p class="pick-play__text paragraph">{{ bs.description | escape }}</p>
                {% endif %}
              </div>

              {% if bs.link_label != blank and tag == 'a' %}
                <span class="pick-play__cta">
                  <span class="pick-play__cta-label">{{ bs.link_label | escape }}</span>
                  <span class="pick-play__cta-icon" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                </span>
              {% endif %}
            </div>
          </{{ tag }}>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .pick-play {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
  }

  .pick-play__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .pick-play__header--center {
    text-align: center;
    align-items: center;
  }

  .pick-play__heading,
  .pick-play__subheading {
    margin: 0;
  }

  .pick-play__subheading {
    color: var(--color-foreground-muted);
    max-width: 60ch;
  }

  .pick-play__grid {
    display: grid;
    grid-template-columns: repeat(var(--pp-columns), minmax(0, 1fr));
    gap: var(--pp-gap);
    margin: 0;
    padding: 0;
  }

  .pick-play__item {
    min-width: 0;
  }

  .pick-play__card {
    --card-bg: rgb(var(--color-foreground-rgb) / 0.06);

    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--card-fg);
    background-color: var(--card-bg);
    border-radius: var(--pp-radius);
    overflow: hidden;
    text-decoration: none;
    /* Isolates the rounded clip so the hover transform doesn't repaint the page */
    isolation: isolate;
  }

  a.pick-play__card:focus-visible {
    outline: 2px solid var(--card-fg);
    outline-offset: 3px;
  }

  .pick-play__media {
    aspect-ratio: var(--pp-ratio);
    overflow: hidden;
    flex-shrink: 0;
  }

  .pick-play__media--placeholder {
    --stripe: 1.5rem;

    background-color: rgb(255 255 255 / 0.45);
    background-image: repeating-linear-gradient(
      -45deg,
      var(--card-bg) 0 var(--stripe),
      transparent var(--stripe) calc(var(--stripe) * 2)
    );
  }

  .pick-play__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pick-play__body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gap-md);
    flex-grow: 1;
    padding: clamp(1.25rem, 5%, 2.5rem);
  }

  .pick-play__copy {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    min-width: 0;
  }

  .pick-play__title,
  .pick-play__text {
    margin: 0;
    color: inherit;
  }

  .pick-play__text {
    color: color-mix(in srgb, var(--card-fg) 72%, transparent);
  }

  /* Pill call-to-action, uses the card's text colour so it always reads on the pastel */
  .pick-play__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    flex-shrink: 0;
    padding: 0.55em 1em;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--card-bg);
    background-color: var(--card-fg);
  }

  .pick-play__cta-icon {
    display: inline-flex;
    width: 1.1em;
    height: 1.1em;
  }

  .pick-play__cta-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Hover: transform-only, pointer devices only, honours reduced-motion */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pick-play__img,
    .pick-play__cta-icon {
      transition: transform var(--animation-speed-slow) var(--ease-out-cubic);
    }

    a.pick-play__card:hover .pick-play__img {
      transform: scale(1.04);
    }

    a.pick-play__card:hover .pick-play__cta-icon {
      transform: translateX(0.2em);
    }
  }

  @media screen and (max-width: 989px) {
    .pick-play__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .pick-play__body {
      flex-direction: column;
      align-items: flex-start;
    }

    .pick-play--mobile-stack .pick-play__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Horizontal snap carousel, bleeding to the viewport edges — no JS needed */
    .pick-play--mobile-scroll .pick-play__grid {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--page-margin));
      padding-inline: var(--page-margin);
      scroll-padding-inline: var(--page-margin);
      -webkit-overflow-scrolling: touch;
    }

    .pick-play--mobile-scroll .pick-play__grid::-webkit-scrollbar {
      display: none;
    }

    .pick-play--mobile-scroll .pick-play__item {
      flex: 0 0 min(85vw, 24rem);
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pick your play",
  "tag": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Toys or Books — Pick Your Play"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "stack", "label": "Stacked" },
        { "value": "scroll", "label": "Horizontal scroll" }
      ],
      "default": "stack"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Performance"
    },
    {
      "type": "checkbox",
      "id": "eager_first_row",
      "label": "Load first row images immediately",
      "info": "Turn on only if this section is visible at the top of the page. Otherwise images lazy-load as the visitor scrolls.",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "play_card",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 1600 × 900 px (16:9). Larger images are resized automatically."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Toys"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Wooden, sensory & building toys for hands-on play."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Button label",
          "info": "Shown as a pill button on the card. Only appears when a link is set.",
          "default": "Shop now"
        },
        {
          "type": "color",
          "id": "card_color",
          "label": "Card color",
          "default": "#F4E8D4"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "info": "Leave empty to pick a readable color automatically."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pick your play",
      "category": "Collections",
      "blocks": [
        {
          "type": "play_card",
          "settings": {
            "title": "Toys",
            "description": "Wooden, sensory & building toys for hands-on play.",
            "link_label": "Shop Toys",
            "card_color": "#F4E8D4"
          }
        },
        {
          "type": "play_card",
          "settings": {
            "title": "Books",
            "description": "Interactive, pop-up & story books for early readers.",
            "link_label": "Shop Books",
            "card_color": "#E4E1FA"
          }
        }
      ]
    }
  ]
}
{% endschema %}
