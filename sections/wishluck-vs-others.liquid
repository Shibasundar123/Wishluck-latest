{% schema %}
{
  "name": "Wishluck vs Others",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wishluck vs Others"
    }
  ],
  "presets": [
    {
      "name": "Wishluck vs Others"
    }
  ]
}
{% endschema %}

<!-- FONT IMPORT -->
<style>
@font-face {
  font-family: 'Gentisans';
  src: url('{{ "Gentisans-Regular.woff2" | asset_url }}') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
</style>

<section class="wvo-section">
  <div class="wvo-container page-width">

    {% if section.settings.heading != blank %}
      <h2 class="wvo-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="wvo-table-wrap">
      <table class="wvo-table">
        <thead>
          <tr>
            <th class="wvo-col-label"></th>
            <th class="wvo-col-us">Wishluck</th>
            <th class="wvo-col-them">Others</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="wvo-row-label">Zero screen time &mdash; works completely off-screen</td>
            <td class="wvo-cell wvo-us"><span class="wvo-icon wvo-check">&#10003;</span></td>
            <td class="wvo-cell wvo-them"><span class="wvo-icon wvo-tilde">&#8764;</span></td>
          </tr>
          <tr>
            <td class="wvo-row-label">Non-toxic, BPA-free, no small detachable parts</td>
            <td class="wvo-cell wvo-us"><span class="wvo-icon wvo-check">&#10003;</span></td>
            <td class="wvo-cell wvo-them"><span class="wvo-icon wvo-cross">&#10007;</span></td>
          </tr>
          <tr>
            <td class="wvo-row-label">Designed for a specific stage within 0&ndash;7 years</td>
            <td class="wvo-cell wvo-us"><span class="wvo-icon wvo-check">&#10003;</span></td>
            <td class="wvo-cell wvo-them"><span class="wvo-icon wvo-tilde">&#8764;</span></td>
          </tr>
          <tr>
            <td class="wvo-row-label">Tested to handle daily use by small hands</td>
            <td class="wvo-cell wvo-us"><span class="wvo-icon wvo-check">&#10003;</span></td>
            <td class="wvo-cell wvo-them"><span class="wvo-icon wvo-tilde">&#8764;</span></td>
          </tr>
          <tr>
            <td class="wvo-row-label">Culturally relevant themes &amp; bilingual options</td>
            <td class="wvo-cell wvo-us"><span class="wvo-icon wvo-check">&#10003;</span></td>
            <td class="wvo-cell wvo-them"><span class="wvo-icon wvo-cross">&#10007;</span></td>
          </tr>
          <tr>
            <td class="wvo-row-label">Works out of the box &mdash; no app, Wi-Fi or subscription</td>
            <td class="wvo-cell wvo-us"><span class="wvo-icon wvo-check">&#10003;</span></td>
            <td class="wvo-cell wvo-them"><span class="wvo-icon wvo-cross">&#10007;</span></td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

<style>
.wvo-section {
  padding: 60px 0;
  background: #fdf8f0;
}

.wvo-container {
  font-family: 'Gentisans', sans-serif;
  padding-left: var(--page-margin, 16px);
  padding-right: var(--page-margin, 16px);
}

.wvo-heading {
  text-align: center;
  font-size: 34px;
  color: #1a1a1a;
  font-weight: 700;
  margin: 0 0 30px;
}

.wvo-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 16px;
  box-shadow: 0 4px 18px rgba(0,0,0,0.06);
}

.wvo-table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
}

.wvo-table thead th {
  padding: 18px 16px;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  background: #fff;
  word-break: break-word;
}

.wvo-col-label {
  width: 46%;
}

.wvo-col-us,
.wvo-col-them {
  width: 27%;
}

.wvo-col-us {
  background: #e8785a !important;
  color: #fff !important;
  border-radius: 10px 10px 0 0;
}

.wvo-col-them {
  background: #ece7de !important;
  color: #6b6b6b !important;
}

.wvo-table tbody td {
  padding: 16px;
  font-size: 15px;
  border-top: 1px solid #f1ece3;
  text-align: center;
  word-break: break-word;
}

.wvo-row-label {
  text-align: left !important;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.wvo-table tbody tr:nth-child(odd) .wvo-row-label,
.wvo-table tbody tr:nth-child(odd) .wvo-us {
  background: #fdf8f0;
}

.wvo-icon {
  display: inline-block;
  font-size: 18px;
  font-weight: 700;
  line-height: 1;
}

.wvo-check {
  color: #2e9e4f;
}

.wvo-tilde {
  color: #d9a824;
}

.wvo-cross {
  color: #d9483a;
}

/* Tablet */
@media screen and (max-width: 749px) {
  .wvo-section {
    padding: 45px 0;
  }

  .wvo-heading {
    font-size: 26px;
    margin-bottom: 22px;
  }

  .wvo-table thead th {
    font-size: 14px;
    padding: 14px 8px;
  }

  .wvo-table tbody td {
    font-size: 13px;
    padding: 12px 8px;
  }
}

/* Mobile */
@media screen and (max-width: 480px) {
  .wvo-section {
    padding: 32px 0;
  }

  .wvo-heading {
    font-size: 21px;
    margin-bottom: 18px;
  }

  .wvo-col-label {
    width: 48%;
  }

  .wvo-col-us,
  .wvo-col-them {
    width: 26%;
  }

  .wvo-table thead th {
    font-size: 12px;
    padding: 10px 4px;
  }

  .wvo-table tbody td {
    padding: 10px 4px;
  }

  .wvo-row-label {
    font-size: 11.5px;
  }

  .wvo-icon {
    font-size: 14px;
  }
}

@media screen and (max-width: 360px) {
  .wvo-heading {
    font-size: 18px;
  }

  .wvo-table thead th {
    font-size: 11px;
  }

  .wvo-row-label {
    font-size: 10.5px;
  }
}
</style>