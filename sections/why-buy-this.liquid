{%- liquid
  assign wbt_points = blank
  assign wbt_field = product.metafields.custom.why_buy_this

  if wbt_field.value != blank
    assign wbt_points = wbt_field.value
  endif
-%}

{%- if product != blank and wbt_points != blank -%}
  <div class="why-buy-this" style="
    --wbt-bg: {{ section.settings.background_color }};
    --wbt-heading-color: {{ section.settings.heading_color }};
    --wbt-highlight-color: {{ section.settings.highlight_color }};
    --wbt-text-color: {{ section.settings.text_color }};
    --wbt-check-color: {{ section.settings.check_color }};
    --wbt-padding-top: {{ section.settings.padding_top }}px;
    --wbt-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
    <div class="why-buy-this__inner page-width why-buy-this__inner--{{ section.settings.image_position }}">
      <div class="why-buy-this__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '375, 550, 750, 1100, 1500'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'why-buy-this__placeholder' }}
        {%- endif -%}
      </div>
      <div class="why-buy-this__content">
        {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
          <h2 class="why-buy-this__heading">
            {%- if section.settings.heading_line_1 != blank -%}
              <span class="why-buy-this__heading-line">{{ section.settings.heading_line_1 }}</span>
            {%- endif -%}
            {%- if section.settings.heading_line_2 != blank -%}
              <span class="why-buy-this__heading-line why-buy-this__heading-line--highlight">{{ section.settings.heading_line_2 }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
        <ul class="why-buy-this__list" role="list">
          {%- for point in wbt_points -%}
            {%- liquid
              assign point_text = point
              if point.text.value != blank
                assign point_text = point.text.value
              elsif point.value != blank
                assign point_text = point.value
              endif
            -%}
            {%- if point_text != blank -%}
              <li class="why-buy-this__item">
                <svg class="why-buy-this__check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{{ point_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .why-buy-this {
    background-color: var(--wbt-bg);
    padding-top: var(--wbt-padding-top);
    padding-bottom: var(--wbt-padding-bottom);
  }

  .why-buy-this__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
  }

  .why-buy-this__inner--right .why-buy-this__media {
    order: 2;
  }

  .why-buy-this__media {
    border-radius: 1.2rem;
    overflow: hidden;
  }

  .why-buy-this__media img,
  .why-buy-this__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .why-buy-this__heading {
    margin: 0 0 2rem;
    font-size: 3.2rem;
    line-height: 1.15;
  }

  .why-buy-this__heading-line {
    display: block;
    color: var(--wbt-heading-color);
    font-weight: 800;
  }

  .why-buy-this__heading-line--highlight {
    color: var(--wbt-highlight-color);
    font-style: italic;
  }

  .why-buy-this__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .why-buy-this__item {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    color: var(--wbt-text-color);
    font-size: 1.7rem;
    line-height: 1.5;
  }

  .why-buy-this__check {
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    margin-top: 0.2rem;
    color: var(--wbt-check-color);
  }

  @media screen and (max-width: 749px) {
    .why-buy-this__inner {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .why-buy-this__inner--right .why-buy-this__media {
      order: 0;
    }

    .why-buy-this__heading {
      font-size: 2.4rem;
      margin-bottom: 1.4rem;
    }

    .why-buy-this__list {
      gap: 1.1rem;
    }

    .why-buy-this__item {
      font-size: 1.5rem;
      gap: 0.9rem;
    }

    .why-buy-this__check {
      width: 1.7rem;
      height: 1.7rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why buy this",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "5 Reasons Kids"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (highlighted)",
      "default": "Love This Book Set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#f6c453"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "List text color",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmark color",
      "default": "#f6c453"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Why buy this"
    }
  ]
}
{% endschema %}
